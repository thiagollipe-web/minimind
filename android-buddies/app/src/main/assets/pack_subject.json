{
  "version": 1,
  "notes": [
    {
      "title": "frações",
      "text": "Use o denominador comum 4: 2/4 + 1/4 = 3/4."
    },
    {
      "title": "equações",
      "text": "Subtraia 3 dos dois lados e divida por 2."
    },
    {
      "title": "porcentagem",
      "text": "20% equivale a 0,20; multiplique por 150."
    },
    {
      "title": "Somar frações no cotidiano",
      "text": "1/3 equivale a 2/6. Então 2/6 + 1/6 = 3/6 = 1/2."
    },
    {
      "title": "Equações e igualdade",
      "text": "3x + 2 = 17; 3x = 15; x = 5."
    },
    {
      "title": "Porcentagem e desconto",
      "text": "25% de 80 são 20; 80 − 20 = 60."
    },
    {
      "title": "Razões entre grandezas",
      "text": "180 ÷ 3 = 60 km/h."
    }
  ]
}
